{
  "name": "@holokai/holo-provider-openai",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenAI provider plugin for Holo LLM Gateway",
  "author": "Holokai",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holokai/holo-provider-openai.git"
  },
  "bugs": {
    "url": "https://github.com/holokai/holo-provider-openai/issues"
  },
  "homepage": "https://github.com/holokai/holo-provider-openai#readme",
  "keywords": [
    "holokai",
    "holo",
    "plugin",
    "provider",
    "openai",
    "ai",
    "llm"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@holokai/sdk": "^0.1.0"
  },
  "dependencies": {
    "openai": "^6.17.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.11",
    "jest": "^29.7.0",
    "typescript": "^5.8.3"
  }
}
